# Production .env for /my-apps/asendus on the VPS. Its contents go in the ENV_FILE GitHub secret.
DOCKERHUB_USERNAME=

POSTGRES_USER=asendus
POSTGRES_PASSWORD=
POSTGRES_DB=asendus

# The Google OAuth web client ID the app signs in with (comma-separate several)
GOOGLE_CLIENT_IDS=

# Generate one by running `openssl rand -base64 32` in the Terminal
JWT_SECRET=

# Comma-separated Google emails allowed to sign in
ALLOWED_EMAILS=iliarebla@gmail.com,tomimarkusalber@gmail.com

# Web origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=https://asendus.alber.ee
